# Optional. Without a key the app runs in offline demo mode using curated campaigns.
ANTHROPIC_API_KEY=

# Model used for generation (fast by default; try claude-sonnet-5-5 for richer copy)
AI_MODEL=claude-haiku-5-5

# Abort and fall back to curated campaigns after this many ms
AI_TIMEOUT_MS=25000

# Force offline mode even if a key is set (great for flaky venue Wi-Fi)
DEMO_MODE=false

# Shown in the navbar GitHub link
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/impactforge
